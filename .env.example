# Public values (also paste into js/booking/config.js)
SUPABASE_URL=
SUPABASE_ANON_KEY=
GOOGLE_MAPS_BROWSER_KEY=

# Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets)
# Note: driving distance is calculated with a static formula (see
# supabase/functions/_shared/distance.js), so no Google Maps server key
# or Routes API billing is required for pricing.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
QUO_API_KEY=
QUO_FROM=
QUO_SMS_URL=https://api.openphone.com/v1/messages
RESEND_API_KEY=
BOOKING_FROM_EMAIL=Hercules Movers <bookings@yourdomain.com>
BOOKING_REPLY_TO=herculesmoversfl@gmail.com
NOTIFY_EMAIL=herculesmoversfl@gmail.com
ALLOWED_ORIGINS=https://herculesmovingfl.com,https://www.herculesmovingfl.com
